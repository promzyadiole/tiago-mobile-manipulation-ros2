<!--
  Behaviour tree for NavigateToPose used in this project.

  Based on Nav2's navigate_to_pose_w_replanning_and_recovery.xml (replans the
  path at 1 Hz, retries on failure) but WITHOUT the ClearEntireCostmap
  recoveries: in this simulation, clearing the local costmap left the
  controller_server unable to receive the map->odom transform afterwards
  ("Transform data too old when converting from map to odom"), so the robot
  could not move any more. The remaining recoveries are wait / back up / spin.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Wait wait_duration="2"/>
          <BackUp backup_dist="0.20" backup_speed="0.1"/>
          <Spin spin_dist="0.8"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
