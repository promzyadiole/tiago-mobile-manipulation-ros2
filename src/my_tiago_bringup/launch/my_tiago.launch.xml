<?xml version="1.0"?>
<!--
  my_tiago bringup with ros2_control MOCK hardware (no Gazebo, no real robot).

  Starts, in one command, what the five test terminals started by hand:
    1. ros2_control_node        controller manager with mock hardware
    2. spawners                 load + activate the controllers from config/my_tiago_controllers.yaml
    3. robot_state_publisher    URDF + /joint_states -> TF
    4. move_group               MoveIt planning/execution (from my_tiago_moveit_config)
    5. rviz2                    MoveIt MotionPlanning view (optional)

  Usage:
    ros2 launch my_tiago_bringup my_tiago.launch.xml
    ros2 launch my_tiago_bringup my_tiago.launch.xml rviz:=false
-->
<launch>

  <!-- ===== Arguments ===== -->
  <arg name="rviz" default="true" description="Start RViz with the MoveIt MotionPlanning panel"/>

  <!-- ===== Files ===== -->
  <let name="model" value="$(find-pkg-share my_tiago_description)/urdf/my_tiago.urdf.xacro"/>
  <let name="controllers_config" value="$(find-pkg-share my_tiago_bringup)/config/my_tiago_controllers.yaml"/>

  <!-- Robot description (URDF text), generated by xacro at launch time.
       use_mock_hardware:=true selects mock_components/GenericSystem in the
       ros2_control block (option added in the tiago_description overlay). -->
  <let name="robot_description"
       value="$(command 'xacro $(var model) use_mock_hardware:=true')"/>

  <!-- ===== 1. Controller manager (mock hardware) =====
       - No name="..." here: in a launch file it renames EVERY node in the
         process, and the controllers run inside this process. They would all
         be renamed "controller_manager" and lose their blocks in the YAML.
         The default node name is already "controller_manager".
       - Its own parameters (update_rate) come from the controller_manager:
         block of the YAML file.
       - The robot model comes from robot_state_publisher's /robot_description
         topic (the recommended way; a robot_description parameter would also
         be passed to every controller node in the process). -->
  <node pkg="controller_manager" exec="ros2_control_node" output="screen">
    <param from="$(var controllers_config)"/>
    <remap from="~/robot_description" to="/robot_description"/>
  </node>

  <!-- ===== 2. Controllers =====
       ONE spawner handles all controllers, one after another: it waits for the
       controller manager, then loads, configures and activates each controller
       using its block in the -p file. joint_state_broadcaster comes first
       because everything else needs /joint_states.
       (Two spawners running at the same time collide in ROS 2 Humble: a
       controller can be left 'unconfigured'.) -->
  <node pkg="controller_manager" exec="spawner" name="spawner"
        args="joint_state_broadcaster arm_controller torso_controller gripper_controller
              head_controller mobile_base_controller ft_sensor_controller
              -p $(var controllers_config)"/>

  <!-- ===== 3. robot_state_publisher (TF) ===== -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="log">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
  </node>

  <!-- ===== 4. MoveIt move_group =====
       Uses my_tiago_moveit_config (SRDF, kinematics, moveit_controllers.yaml). -->
  <include file="$(find-pkg-share my_tiago_moveit_config)/launch/move_group.launch.py"/>

  <!-- ===== 5. RViz with MoveIt MotionPlanning ===== -->
  <include file="$(find-pkg-share my_tiago_moveit_config)/launch/moveit_rviz.launch.py" if="$(var rviz)"/>

</launch>
